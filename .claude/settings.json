{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/team-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking the /team ledger is approved…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-guard.py",
            "timeout": 20,
            "statusMessage": "failures-ledger guard: checking recorded mistake classes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/render-deploy-watch.sh",
            "asyncRewake": true,
            "timeout": 1080,
            "statusMessage": "Watching Render deploy after git push…"
          }
        ]
      }
    ]
  }
}
