{
  "worktree": {
    "baseRef": "head"
  },
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); bash \"$ROOT/.claude/hooks/team-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the /team ledger is approved…"
          },
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" code-grounding-guard.py",
            "timeout": 20,
            "statusMessage": "verifier gate: the shadow must be able to read the plan"
          },
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" pre-shadow-check.py",
            "timeout": 150,
            "statusMessage": "pre-shadow check: citations, numbers and the engine guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" ledger-guard.py",
            "timeout": 20,
            "statusMessage": "failures-ledger guard: checking recorded mistake classes"
          },
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" production-junk-guard.py",
            "timeout": 30,
            "statusMessage": "production-junk guard: keeping test artefacts out of history"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" advisor-consult-guard.py",
            "timeout": 20,
            "statusMessage": "advisor gate: no action before a consult and a printed plan"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" parallel-gate.py",
            "timeout": 15,
            "statusMessage": "parallel gate: batch independent background spawns"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" doctor.py",
            "timeout": 30,
            "statusMessage": "hook doctor: can this machine satisfy the guards?"
          },
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" advisor-router.py",
            "timeout": 30,
            "statusMessage": "advisor router: fable if it can, opus if it cannot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" code-grounding-guard.py",
            "timeout": 90,
            "statusMessage": "codegraph sync: the index every agent reads from"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); bash \"$ROOT/.claude/hooks/render-deploy-watch.sh\"",
            "asyncRewake": true,
            "timeout": 1080,
            "statusMessage": "Watching Render deploy after git push…"
          },
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" run-recorder.py",
            "timeout": 15,
            "statusMessage": "run recorder: writing down what the command actually returned"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" run-recorder.py",
            "timeout": 15,
            "statusMessage": "run recorder: stamping the file and when it changed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" delivery-guard.py",
            "timeout": 30,
            "statusMessage": "delivery guard: stop polishing the reply, go do the work"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" citation-guard.py",
            "timeout": 20,
            "statusMessage": "citation guard: proving every claim about this repo"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" plain-words-guard.py",
            "timeout": 20,
            "statusMessage": "plain-words gate: replies the owner can read"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" freshness-gate.py",
            "timeout": 20,
            "statusMessage": "freshness gate: every number said today is proven today"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" advisor-consult-guard.py",
            "timeout": 20,
            "statusMessage": "advisor guard: no reply without a consult"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" production-junk-guard.py",
            "timeout": 30,
            "statusMessage": "production-junk guard: keeping test artefacts out of history"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" shadow-guard.py",
            "timeout": 20,
            "statusMessage": "shadow gate: nothing is reported until it is re-derived"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" truth-gate.py",
            "timeout": 300,
            "statusMessage": "truth gate: advisor and verifier must both call it true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo \"${CLAUDE_PROJECT_DIR:-.}\"); sh \"$ROOT/.claude/hooks/run.sh\" proceed-guard.py",
            "timeout": 20,
            "statusMessage": "proceed guard: keep going, stop only by asking a real question"
          }
        ]
      }
    ]
  }
}
