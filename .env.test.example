NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=ondoway_test_2026

# Public Apple Developer team id (not a secret — also in .env.example & render.yaml).
# The AASA endpoint test (test_auth_aasa.py) needs it set.
APPLE_TEAM_ID=BC7F6Q48GB

# Test-only JWT secrets. NEVER use these values outside the test suite.
# pyjwt 2.13+ rejects empty HMAC keys and warns when keys are below RFC 7518
# minimum 32 bytes for HS256, so both secrets are 32+ chars of obvious filler.
JWT_SECRET_KEY=test-jwt-secret-not-for-production-aaaaaaaaaaaaaaaa
MAGIC_LINK_SECRET_KEY=test-magic-link-secret-not-for-production-bbbb
