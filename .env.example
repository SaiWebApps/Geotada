NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ondoway_dev_2026
# NEO4J_DATABASE=  # Optional: set for Neo4j Aura (e.g. your instance ID)

# ── TTS Audio Pipeline ──
# Provider: "mock" (default, no API key needed), "openai" (dev), "elevenlabs" (prod)
TTS_PROVIDER=mock

# OpenAI TTS (dev provider) — also needed for audio evals (Whisper STT)
OPENAI_API_KEY=
OPENAI_VOICE=nova

# ElevenLabs TTS (production provider)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Storage: "local" (default), "s3", or "r2"
AUDIO_STORAGE=local
AUDIO_STORAGE_PATH=audio_store
AWS_S3_BUCKET=ondoway-audio

# Cloudflare R2 (S3-compatible, zero egress — recommended for production)
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ondoway-audio
R2_PUBLIC_URL=https://audio.ondoway.com

# ── Voice Feedback → GitHub Issues ──
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# ── Authentication ──
JWT_SECRET_KEY=change-me-in-production
MAGIC_LINK_SECRET_KEY=change-me-magic-link
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAGIC_LINK_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:8000

# ── Universal Links (iOS) ──
APPLE_TEAM_ID=BC7F6Q48GB

# ── Apple Sign-In ──
APPLE_KEY_ID=
