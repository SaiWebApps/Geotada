# ═══════════════════════════════════════════════════════════════════════════
#  NO MAKE TARGET READS THIS FILE.  Copying it to .env configures nothing.
# ═══════════════════════════════════════════════════════════════════════════
#
# Make owns configuration (see CLAUDE.md, "Config Layering").  Every target runs
# through scripts/dev_env.py, which builds the child environment from exactly two
# sources:
#
#   1. config/profiles/{local,test,workbench}  -- committed, non-secret, the local
#      Neo4j endpoint and storage settings.  THIS is what sets NEO4J_*.
#   2. the live Render service environment, fetched over the API on every run for
#      targets marked --render.  THIS is the only source of ANTHROPIC_API_KEY,
#      OPENAI_API_KEY, RESEND_API_KEY and every other provider secret.  They are
#      never written to disk.  Authorise once with `make render-auth-setup`.
#
# So filling in a key below will NOT make `make workbench`, `make api` or
# `make test` find it.  If a target reports a missing credential, run
# `make doctor` -- it names the real remedy.
#
# This file survives only as a reference for the full set of variables the
# deployed service expects (mirrored in render.yaml), and for three calibration
# scripts that are NOT Make targets and do call load_dotenv():
# scripts/tour_text_candidate.py, scripts/coverage_calibrate.py,
# scripts/faithfulness_calibrate.py.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ondoway_dev_2026
# NEO4J_DATABASE=  # Optional: set for Neo4j Aura (e.g. your instance ID)

# ── TTS Audio Pipeline ──
# Provider: "openai" or "elevenlabs". There is NO default and no "mock" here —
# get_provider() fails closed, because an unpinned server once answered every
# /audio request with a silent WAV an editor could mistake for real narration.
TTS_PROVIDER=openai
# TTS_FALLBACK: ordered understudies (comma-separated) for a TOURIST's audio when
# the pinned voice cannot speak — a vendor outage, or a script one vendor refuses,
# then costs a different narrator instead of silence. Leave empty for no fallback.
# Only the unnamed path chains; /audio/compare and /audio/eval still get exactly
# the provider they name.
#   elevenlabs — a different company, so a different failure
# The THIRD tier is not a provider here: it lives on the surfaces. A stop that
# has narration text but no audio file is spoken by the phone's (or the
# workbench browser's) own OS voice — the only thing that survives a phone with
# no signal, which no server-side provider can help with.
TTS_FALLBACK=elevenlabs

# OpenAI TTS (dev provider) — also needed for audio evals (Whisper STT)
OPENAI_API_KEY=
OPENAI_VOICE=nova

# ElevenLabs TTS (production provider)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Storage: "local" (default), "s3", or "r2"
AUDIO_STORAGE=local
AUDIO_STORAGE_PATH=audio_store
AWS_S3_BUCKET=ondoway-audio

# Cloudflare R2 (S3-compatible, zero egress — recommended for production)
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ondoway-audio
R2_PUBLIC_URL=https://audio.ondoway.com

# ── Voice Feedback → GitHub Issues ──
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# ── Authentication ──
JWT_SECRET_KEY=change-me-in-production
MAGIC_LINK_SECRET_KEY=change-me-magic-link
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAGIC_LINK_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:8000

# ── Universal Links (iOS) ──
APPLE_TEAM_ID=BC7F6Q48GB

# ── Apple Sign-In ──
APPLE_KEY_ID=

# ── Aura auto-resume (wakes a PAUSED AuraDB on a failed DB probe) ──
# Created ONCE in the Aura Console → Account → API Credentials (client id + secret).
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
# Optional: the Aura instance id. Leave blank to auto-derive from NEO4J_URI host
# (neo4j+s://8a37bbaf.databases.neo4j.io → 8a37bbaf).
AURA_INSTANCE_ID=
