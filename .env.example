NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=travlr_dev_2026

# ── TTS Audio Pipeline ──
# Provider: "mock" (default, no API key needed), "openai" (dev), "elevenlabs" (prod)
TTS_PROVIDER=mock

# OpenAI TTS (dev provider) — also needed for audio evals (Whisper STT)
OPENAI_API_KEY=
OPENAI_VOICE=nova

# ElevenLabs TTS (production provider)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Storage: "local" (default) or "s3"
AUDIO_STORAGE=local
AUDIO_STORAGE_PATH=audio_store
AWS_S3_BUCKET=travlr-audio
